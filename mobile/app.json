{
  "expo": {
    "name": "TekBooks",
    "slug": "tekbooks",
    "version": "1.0.10",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tekbooks",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9FFFE"
    },
    "android": {
      "package": "com.tekcorp.tekbooks",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F9FFFE"
      },
      "permissions": [
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS"
      ],
      "versionCode": 10
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "TekBooks needs photo access so you can attach receipts and choose a profile or company logo.",
          "cameraPermission": "TekBooks can use the camera to capture receipts.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#10C8A9"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "autolinkingModuleResolution": true
    }
  }
}
