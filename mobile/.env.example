# Expo Go development can auto-detect the current Metro/LAN IP.
EXPO_PUBLIC_AUTO_LAN=true
# In tunnel mode, proxy the local API and media through Metro's public URL.
EXPO_PUBLIC_PROXY_API_THROUGH_METRO=true
# Used by emulator or native builds when auto-LAN is disabled.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api
