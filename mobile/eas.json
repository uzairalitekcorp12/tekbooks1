{
  "cli": {"version": ">= 16.17.0"},
  "build": {
    "development": {"developmentClient": true,"distribution":"internal","environment":"development"},
    "preview": {
      "distribution":"internal",
      "environment":"preview",
      "env":{"EXPO_PUBLIC_API_URL":"https://tekbooks1.vercel.app/api","EXPO_PUBLIC_AUTO_LAN":"false","EXPO_PUBLIC_PROXY_API_THROUGH_METRO":"false"},
      "android":{"buildType":"apk"}
    },
    "production": {
      "environment":"production",
      "env":{"EXPO_PUBLIC_API_URL":"https://tekbooks1.vercel.app/api","EXPO_PUBLIC_AUTO_LAN":"false","EXPO_PUBLIC_PROXY_API_THROUGH_METRO":"false"},
      "android":{"buildType":"app-bundle"}
    }
  }
}
