# Runtime
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
MOBILE_SCHEME=tekbooks

# MongoDB
# Local development:
MONGODB_URI=mongodb://127.0.0.1:27017/tekbooks
# Production Atlas example:
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/tekbooks?retryWrites=true&w=majority

# Security
JWT_SECRET=dev-only-change-this-secret-please
MEDIA_SIGNING_SECRET=
# Signed proxy links are renewed whenever records/profile data are returned.
MEDIA_URL_TTL_SECONDS=86400
# Set false after legacy /media links have been refreshed in production.
MEDIA_ALLOW_LEGACY_SIGNATURES=true
ALLOW_EXPO_GO_DEVICE_BYPASS=true
ADMIN_API_KEY=dev-admin-key

# Email
RESEND_API_KEY=
RESEND_FROM=TekBooks <onboarding@resend.dev>

# Storage
# local = disk for local development
# s3   = AWS S3 or an S3-compatible provider such as Cloudflare R2
STORAGE_DRIVER=local
STORAGE_PUBLIC_MODE=proxy
STORAGE_KEY_PREFIX=users
STORAGE_AUTO_CREATE_BUCKET=false
STORAGE_VALIDATE_ON_STARTUP=true
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# AWS S3 example:
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=tekbooks-production
S3_PUBLIC_BASE_URL=

# Cloudflare R2 example instead of AWS S3:
# S3_REGION=auto
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
# S3_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
# S3_BUCKET=tekbooks-production
# S3_PUBLIC_BASE_URL=

EXPO_PUSH_ACCESS_TOKEN=
