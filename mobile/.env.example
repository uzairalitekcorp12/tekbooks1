# Expo Go development auto-detects the current Metro/LAN IP after Wi-Fi changes.
EXPO_PUBLIC_AUTO_LAN=true
# Proxy the local API and media through Metro. This is required in tunnel mode.
EXPO_PUBLIC_PROXY_API_THROUGH_METRO=true
# Fallback used by an Android emulator or when Metro discovery is unavailable.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api

# Installed APK / EAS preview and production builds:
# EXPO_PUBLIC_AUTO_LAN=false
# EXPO_PUBLIC_PROXY_API_THROUGH_METRO=false
# EXPO_PUBLIC_API_URL=https://YOUR-PROJECT.vercel.app/api
