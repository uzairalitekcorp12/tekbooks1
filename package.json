{
  "name": "tekbooks",
  "private": true,
  "version": "1.0.10",
  "scripts": {
    "setup": "node scripts/install.mjs",
    "start": "npm run dev",
    "dev": "node scripts/dev.mjs",
    "api": "npm --prefix backend start",
    "app": "npm --prefix mobile start -- --lan --go",
    "db:start": "docker compose up -d mongodb",
    "db:check": "npm --prefix backend run db:check",
    "typecheck": "npm --prefix backend run typecheck && npm --prefix mobile run typecheck",
    "verify": "npm run typecheck && npm --prefix backend run config:check",
    "doctor": "npm --prefix mobile run doctor",
    "production:check": "npm --prefix backend run production:check",
    "system:check": "node scripts/run-backend-system-check.mjs",
    "secrets:production": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-production-secrets.ps1",
    "configure:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-local.ps1",
    "mobile:env": "node scripts/setup-mobile-env.mjs",
    "build:apk": "npm --prefix mobile run build:apk",
    "build:aab": "npm --prefix mobile run build:aab",
    "clean:mobile": "node scripts/clean-mobile.mjs",
    "dev:lan": "node scripts/dev.mjs --lan",
    "dev:tunnel": "node scripts/dev.mjs --tunnel",
    "network:check": "node scripts/network-check.mjs",
    "network:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-network-setup.ps1"
  }
}
