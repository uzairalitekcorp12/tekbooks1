# Copy to backend/.env only for manual setup. On Windows, `npm run configure:local`
# is easier and generates the security secrets for you.

# Runtime
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
MOBILE_SCHEME=tekbooks
CORS_ORIGINS=

# MongoDB
# Local development:
MONGODB_URI=mongodb://127.0.0.1:27017/tekbooks
# Production Atlas example:
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/tekbooks?retryWrites=true&w=majority
MONGODB_DB_NAME=tekbooks_dev

# Security
JWT_SECRET=dev-only-change-this-secret-please
MEDIA_SIGNING_SECRET=
# Signed proxy links are renewed whenever records/profile data are returned.
MEDIA_URL_TTL_SECONDS=86400
# Set false after legacy /media links have been refreshed in production.
MEDIA_ALLOW_LEGACY_SIGNATURES=true
ALLOW_EXPO_GO_DEVICE_BYPASS=true
ADMIN_API_KEY=dev-admin-key

# Email
RESEND_API_KEY=
RESEND_FROM=TekBooks <onboarding@resend.dev>
# Temporary Vercel deployment without a domain: true + your Resend login email.
# Only that one address can receive messages until a domain is verified.
RESEND_TEST_MODE=false
RESEND_TEST_RECIPIENT=
# Print OTPs to the local API terminal when Resend is unset. Ignored in production.
EMAIL_DEV_LOG_CODES=true

# Storage
# local = disk for local development
# s3   = AWS S3 or an S3-compatible provider such as Cloudflare R2
STORAGE_DRIVER=local
STORAGE_PUBLIC_MODE=proxy
STORAGE_KEY_PREFIX=users
STORAGE_AUTO_CREATE_BUCKET=false
STORAGE_VALIDATE_ON_STARTUP=true
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Ask the AWS account owner for exactly these four values:
S3_REGION=us-east-1
S3_BUCKET=tekbooks-production
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Normally leave these defaults unchanged for Amazon S3:
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=
S3_UPLOAD_URL_TTL_SECONDS=300
S3_DOWNLOAD_URL_TTL_SECONDS=300

# Cloudflare R2 example instead of AWS S3:
# S3_REGION=auto
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
# S3_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
# S3_BUCKET=tekbooks-production
# S3_PUBLIC_BASE_URL=

EXPO_PUSH_ACCESS_TOKEN=

# Required production values on Vercel:
# NODE_ENV=production
# APP_BASE_URL=https://YOUR-PROJECT.vercel.app
# MONGODB_URI=mongodb+srv://...
# MONGODB_DB_NAME=tekbooks
# JWT_SECRET=<at-least-32-random-characters>
# ADMIN_API_KEY=<at-least-32-random-characters>
# ALLOW_EXPO_GO_DEVICE_BYPASS=false
# RESEND_API_KEY=re_...
# Temporary no-domain deployment:
# RESEND_FROM=TekBooks <onboarding@resend.dev>
# RESEND_TEST_MODE=true
# RESEND_TEST_RECIPIENT=<your-Resend-account-email>
# After domain verification: use your domain, set RESEND_TEST_MODE=false, and leave the recipient empty.
# EMAIL_DEV_LOG_CODES=false
# STORAGE_DRIVER=s3
# S3_REGION=<bucket-region>
# S3_BUCKET=<exact-private-bucket-name>
# S3_ACCESS_KEY_ID=<dedicated-IAM-access-key-ID>
# S3_SECRET_ACCESS_KEY=<dedicated-IAM-secret-access-key>
# STORAGE_PUBLIC_MODE=proxy
# STORAGE_AUTO_CREATE_BUCKET=false
# STORAGE_VALIDATE_ON_STARTUP=true
# MEDIA_ALLOW_LEGACY_SIGNATURES=false
