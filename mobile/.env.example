# TekBooks mobile environment template
# Copy this file to `mobile/.env` or run `npm run mobile:env` from the repo root.
#
# IMPORTANT: Expo public values are embedded in the JavaScript bundle. Never put
# AWS/S3 keys, MongoDB URLs, JWT secrets, Resend keys, or admin keys in this file.

# Required. Keep HTTPS and the trailing /api path.
EXPO_PUBLIC_API_URL=https://tekbooks1.vercel.app/api

# Required for normal Expo Go testing against Vercel and for installed APK/AAB builds.
EXPO_PUBLIC_AUTO_LAN=false
EXPO_PUBLIC_PROXY_API_THROUGH_METRO=false

# Local modes do not require editing this file:
# - `npm run app` uses the Vercel API above.
# - `npm run dev` and `npm run dev:lan` override these values with the current LAN API.
# - `npm run dev:tunnel` overrides them and proxies the local API through Metro.
